# Copy this file to .env (or set these as real environment variables) and
# fill in only what you want to turn on. Every one of these is optional
# except OWNER_PASSWORD — without it, login is refused rather than silently
# open. See the root README.md for what each one actually does and where
# to get its value.

# Required for login.
OWNER_PASSWORD=

# Recommended: without it, a new random secret is generated every boot,
# which logs you out on every restart/redeploy.
JWT_SECRET=

# Where db.json is stored. Leave unset for local dev (defaults to
# server/data). On a host with an ephemeral filesystem, point this at a
# mounted persistent volume so data survives a redeploy.
DATA_DIR=

# Real AI-written product drafts instead of demo placeholders.
ANTHROPIC_API_KEY=

# Real Paddle checkout (all three needed together).
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# "sandbox" for fake test purchases, "production" once Paddle approves you.
PADDLE_ENV=sandbox

# Real stock-price tracking for the financial module (simulated trading only).
MARKET_DATA_API_KEY=

# Default price (USD) for a newly drafted digital product. Falls back to 9
# if unset or invalid.
DEFAULT_PRODUCT_PRICE_USD=9

# Port the server listens on. Defaults to 4000.
PORT=4000
