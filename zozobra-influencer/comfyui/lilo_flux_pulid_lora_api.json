  "8":  {"class_type": "LoadImage", "inputs": {"image": "lilo_face_ref_front.png"}, "_meta": {"title": "FACE_REF"}},
  "9":  {"class_type": "ApplyPulidFlux", "inputs": {"model": ["4", 0], "pulid_flux": ["5", 0], "eva_clip": ["6", 0], "face_analysis": ["7", 0], "image": ["8", 0], "weight": 0.8, "start_at": 0.1, "end_at": 1.0}, "_meta": {"title": "PULID_APPLY"}},
  "10": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["4", 1], "text": ""}, "_meta": {"title": "POSITIVE"}},
  "11": {"class_type": "FluxGuidance", "inputs": {"conditioning": ["10", 0], "guidance": 3.2}, "_meta": {"title": "GUIDANCE"}},
