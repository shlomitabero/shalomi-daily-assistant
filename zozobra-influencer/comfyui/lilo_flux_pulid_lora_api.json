  "15": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["3", 0]}, "_meta": {"title": "DECODE"}},
  "16": {"class_type": "SaveImage", "inputs": {"images": ["15", 0], "filename_prefix": "lilo"}, "_meta": {"title": "SAVE"}}
