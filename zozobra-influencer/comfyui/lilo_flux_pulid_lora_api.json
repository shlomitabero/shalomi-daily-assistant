  "5":  {"class_type": "PulidFluxModelLoader", "inputs": {"pulid_file": "pulid_flux_v0.9.1.safetensors"}, "_meta": {"title": "PULID_MODEL"}},
  "6":  {"class_type": "PulidFluxEvaClipLoader", "inputs": {}, "_meta": {"title": "EVA_CLIP"}},
