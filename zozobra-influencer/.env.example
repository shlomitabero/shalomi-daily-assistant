# --- Brain (Module 3) ---
ANTHROPIC_API_KEY=
ZOZOBRA_MODEL=claude-opus-5-5

# --- Media provider: "fal" (hosted, recommended - one key, no GPU) or "self" (ComfyUI+Runway+Sync+S3) ---
MEDIA_PROVIDER=fal
FAL_KEY=
LILO_LORA_URL=            # printed by: python -m zozobra.fal_provider train data/refs/dataset

# --- Visuals, self-hosted (Module 1) ---
COMFYUI_URL=http://127.0.0.1:8188
LILO_LORA_NAME=lilo_flux_v1.safetensors
LILO_FACE_REF=lilo_face_ref_front.png

# --- Video / lip-sync / voice (Module 2) ---
RUNWAY_API_KEY=
SYNC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Public media hosting (S3 / R2). TikTok PULL_FROM_URL needs a verified domain ---
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=https://media.zozobra.co.il
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Publishing (Module 4) - official APIs only ---
ACCOUNT_CREATED=2026-10-01   # date the IG/TikTok accounts were opened (drives warm-up limits)
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
TIKTOK_ACCESS_TOKEN=

# --- Safety rails ---
REQUIRE_HUMAN_APPROVAL=true
DRY_RUN=true
PANEL_PASSWORD=            # protects the web control panel (required when deployed)
